# Copy this file to .env and replace the placeholder with your own Gemini API key.
DATABASE_URL=sqlite:///./cycle_ai.db
JWT_SECRET=replace_with_a_long_random_secret
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Optional model settings:
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODEL=
# GEMINI_THINKING=minimal

# Optional email reminders via Resend. Use a sender/domain verified in Resend.
# RESEND_API_KEY=re_your_resend_api_key
# RESEND_FROM_EMAIL=Your App <reminders@your-verified-domain.example>
