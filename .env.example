# Copy this file to .env and replace the placeholder with your own Gemini API key.
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Optional model settings:
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODEL=
# GEMINI_THINKING=minimal

# SMTP email settings (Gmail example; use a Google app password, not your normal password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# Use SMTP_PORT=465 for direct SSL if port 587 is blocked on your network.
# SMTP_USER=your Gmail address
# SMTP_PASSWORD=your 16-character Google app password
# SMTP_FROM=your Gmail address
